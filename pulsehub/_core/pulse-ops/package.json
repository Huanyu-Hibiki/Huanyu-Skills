{
  "name": "pulse-ops",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Operational hardening for PulseHub: rate limiting, anomaly detection, health checks, backup.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "pulsehub": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "status": "tsx src/cli.ts status",
    "backup": "tsx src/cli.ts backup",
    "restore": "tsx src/cli.ts restore"
  },
  "dependencies": {
    "@pulsehub/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}

{
  "_comment": "oracle-bone meta-logging hook. Passively records skill invocations, tool calls, and session lifecycle events to .oracle-cache/usage.jsonl. All hooks async fire-and-forget — never blocks. Used by /oracle-status for usage analytics.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.oracle-hooks/log-event.sh tool_use",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.oracle-hooks/log-event.sh user_prompt",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.oracle-hooks/log-event.sh session_start",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.oracle-hooks/log-event.sh session_end",
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}

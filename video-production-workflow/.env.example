# video-production-workflow 私密环境变量
# 复制为 .env 并填写需要使用的服务；.env 位于本 Skill 根目录。
# 不要把真实密钥提交到 Git。

# 本地转录默认使用 faster-whisper（Windows 友好），不需要云端密钥。
# 备选 openai-whisper：脚本加 --engine whisper，或设 ASR_ENGINE=whisper。
# 可选值：local（默认）、flash、v3-standard、auto。
TRANSCRIPTION_ENGINE=local

# 本地转录引擎：faster-whisper（默认）/ whisper
ASR_ENGINE=

# 火山引擎 AI 剪口播 / 字幕转录（可选，仅显式选择云端引擎时需要）
VOLCENGINE_API_KEY=

# Gemini Omni Flash 拼贴 B-roll
GEMINI_API_KEY=

# Vertex AI / Veo 首尾帧视频生成
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# 外部图片和 Stock 视频搜索
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=

# YouTube cookies 文件路径，可选
# Windows 示例：<你的cookies.txt路径>
YTDLP_COOKIES=

# 本地工具路径覆盖，可选
# 默认使用 Skill 内置剪映 vendor；只有替换适配库时才填写。
CAPCUT_MCP_DIR=
# 模型下载目录覆盖；默认为 Skill 根目录下 models/。
VIDEO_MODELS_DIR=
# legacy：Fun-ASR Nano 自定义模型代码目录（仅 funasr_srt.py 需要）
FUNASR_NANO_DIR=
# Chrome/Chromium 不在 PATH 时填写可执行文件路径。
CHROME_PATH=
# CDP 截图设备缩放倍率。
CDP_SCALE=1
